# 环境变量示例：复制为 .env 并按本地情况填写；.env 已被 .gitignore 忽略，不会入库。
# 注意：不要把真实密钥提交到仓库；这里只放占位值。

# 必填：模型服务的 API Key（OpenAI 兼容协议）
LLM_API_KEY=sk-your-api-key

# OpenAI 兼容接口地址（下方按厂商列出常用值，取消注释并替换上一行即可）
LLM_BASE_URL=https://api.openai.com/v1

# --- 国内主流厂商 ---------------------------------------------------------
# DeepSeek（官方）
# LLM_BASE_URL=https://api.deepseek.com/v1
# 火山方舟（豆包 / DeepSeek 等，需在方舟控制台开通模型）
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 阿里云百炼（DashScope OpenAI 兼容模式）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 智谱 BigModel（GLM 系列）
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 月之暗面 Kimi
# LLM_BASE_URL=https://api.moonshot.cn/v1
# 硅基流动 SiliconFlow（聚合多家开源模型）
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# 百度千帆（v2 OpenAI 兼容）
# LLM_BASE_URL=https://qianfan.baidubce.com/v2
# 腾讯混元（OpenAI 兼容）
# LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# 讯飞星火（OpenAI 兼容）
# LLM_BASE_URL=https://spark-api-open.xf-yun.com/v1

# --- 海外 / 聚合 ----------------------------------------------------------
# OpenRouter（聚合多家模型）
# LLM_BASE_URL=https://openrouter.ai/api/v1

# --- 本地部署 -------------------------------------------------------------
# Ollama
# LLM_BASE_URL=http://localhost:11434/v1
# vLLM / LM Studio 等本地 OpenAI 兼容服务
# LLM_BASE_URL=http://localhost:8000/v1

# 以上地址以各厂商官方文档为准；切换厂商时记得同步修改 LLM_MODEL 为对应模型名或接入点 ID。

# 默认模型名称
LLM_MODEL=gpt-4o-mini

# 单次请求超时（秒）
LLM_TIMEOUT=30

# 日志级别：DEBUG / INFO / WARNING / ERROR
LLM_LOG_LEVEL=INFO
